STT_API_KEY=replace-with-random-secret
STT_MODEL=small
STT_DEVICE=cuda
STT_COMPUTE=int8_float16
STT_WORKERS=1
STT_SESSIONS=10
TUNNEL_TOKEN=

STT_STREAM_MAX_LAG_SECONDS=3.0
STT_UTTERANCE_MAX_SECONDS=15

STT_REGISTRY_PATH=/data/registry.sqlite3

STT_APP_REQUESTS_PER_MINUTE=600
STT_APP_DAILY_AUDIO_SECONDS=36000
STT_APP_MONTHLY_AUDIO_SECONDS=720000
STT_APP_CONCURRENCY=8

# Per token subject (end user or device) inside an application.
STT_SUBJECT_REQUESTS_PER_MINUTE=60
STT_SUBJECT_DAILY_AUDIO_SECONDS=3600
STT_SUBJECT_MONTHLY_AUDIO_SECONDS=36000
STT_SUBJECT_CONCURRENCY=2

# Optional independent admin key; unset disables operational endpoints.
# STT_ADMIN_KEY=
