STT_API_KEY=replace-with-random-secret
STT_MODEL=small
STT_DEVICE=cuda
STT_COMPUTE=int8_float16
STT_WORKERS=1
STT_SESSIONS=10
TUNNEL_TOKEN=

STT_STREAM_MAX_LAG_SECONDS=3.0
STT_UTTERANCE_MAX_SECONDS=15

STT_REGISTRY_PATH=/data/registry.sqlite3

STT_APP_REQUESTS_PER_MINUTE=60
STT_APP_DAILY_AUDIO_SECONDS=3600
STT_APP_MONTHLY_AUDIO_SECONDS=36000
STT_APP_CONCURRENCY=2
